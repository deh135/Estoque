<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: #f8f2f1;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.debora.estoque.controller.EstoqueController">
   <top>
      <VBox prefHeight="121.0" prefWidth="700.0" style="-fx-background-color: #f8f2f1;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Estoque de Produtos" textFill="#330708">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <font>
                  <Font name="Broadway" size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="campoBusca" prefHeight="25.0" prefWidth="270.0">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </TextField>
                  <Button fx:id="btnAdicionar" mnemonicParsing="false" onAction="#adicionarProduto" prefWidth="80.0" style="-fx-background-color: #d9abff;" text="+ Adicionar">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <font>
                        <Font name="Bell MT" size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnEditar" layoutX="159.0" layoutY="10.0" mnemonicParsing="false" onAction="#editarProduto" prefWidth="80.0" style="-fx-background-color: #d9abff;" text="Editar">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnRemover" layoutX="221.0" layoutY="10.0" mnemonicParsing="false" onAction="#removerProduto" prefWidth="80.0" style="-fx-background-color: #d9abff;" text="Remover">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnVoltar" layoutX="283.0" layoutY="10.0" mnemonicParsing="false" onAction="#aoVoltarMenu" prefWidth="80.0" style="-fx-background-color: #d9abff;" text="Voltar">
                     <font>
                        <Font name="Bell MT" size="15.0" />
                     </font></Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="30.0" right="30.0" top="20.0" />
         </padding></VBox>
   </top>
   <center>
      <TableView fx:id="tabelaProdutos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colunaID" prefWidth="73.0" text="ID" />
            <TableColumn fx:id="colunaNome" prefWidth="156.0" text="Nome" />
            <TableColumn fx:id="colunaCategoria" minWidth="0.0" prefWidth="165.0" text="Categoria" />
            <TableColumn fx:id="colunaQuantidade" minWidth="0.0" prefWidth="127.0" text="Quantidade" />
            <TableColumn fx:id="colunaPreco" minWidth="0.0" prefWidth="122.0" text="Preço (R$)" />
         </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="30.0" right="30.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
